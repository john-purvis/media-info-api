# media_info_api/.env.example

# [common]
PYTHONPATH=.
JSON_SORT_KEYS=False
# [development]
DEV_DEBUG=True
DEV_MEDIA_DATABASE=media-info-dev.db
DEV_ADMIN_USER=<your admin username goes here>
DEV_ADMIN_PWD=<your admin pwd goes here>
DEV_MEDIA_BASE_PATH=/d/media
# [testing]
TST_DEBUG=True
TST_MEDIA_DATABASE=media-info-tst.db
TST_ADMIN_USER=<your admin username goes here>
TST_ADMIN_PWD=<your admin pwd goes here>
TST_MEDIA_BASE_PATH=/d/media
# [production]
PRD_DEBUG=False
PRD_MEDIA_DATABASE=media-info.db
PRD_ADMIN_USER=<your admin username goes here>
PRD_ADMIN_PWD=<your admin pwd goes here>
PRD_MEDIA_BASE_PATH=/d/media
